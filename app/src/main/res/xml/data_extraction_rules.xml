<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-to-device transfer on Android 12 and higher. Carries the
   learner's progress and settings (SharedPreferences file "progress") to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="progress.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="progress.xml" />
    </device-transfer>
</data-extraction-rules>
